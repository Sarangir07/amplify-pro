# Copy this file to .env.local and fill in your values. .env.local is ignored by git.
#
# Every VITE_ variable is built into the website, so anyone can read it in their
# browser. These IDs and the URL are safe to expose. Never add a password, API key
# or database credential to this file.

# The Lambda Function URL, without a trailing slash.
# Find it as ApiFunctionUrl in the Outputs tab of the nested "function" stack in CloudFormation.
VITE_API_URL=

# In the project's amplify_outputs.json, this is auth.user_pool_id.
VITE_COGNITO_USER_POOL_ID=

# In the project's amplify_outputs.json, this is auth.user_pool_client_id.
VITE_COGNITO_CLIENT_ID=
